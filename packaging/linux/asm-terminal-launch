#!/usr/bin/env sh
# ---------------------------------------------------------------------------
# asm-terminal-launch
# Wrapper that spawns a GUI terminal emulator running the `asm` shell, so a
# shell written in NASM can appear as a standalone application (like
# Terminator, Konsole, etc.). Probes common emulators in preference order.
# ---------------------------------------------------------------------------
set -eu

# Find the ASM shell. Prefer the copy installed next to this launcher, and
# the distinct name `asm-terminal`: a bare `asm` on PATH can be another
# program (pwntools ships /usr/bin/asm on Fedora).
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -z "${ASM_BIN:-}" ]; then
    for cand in \
        "$SELF_DIR/asm-terminal" \
        "$SELF_DIR/asm" \
        "$HOME/.local/bin/asm-terminal" \
        /usr/local/bin/asm-terminal \
        /usr/bin/asm-terminal \
        "$HOME/.local/bin/asm"; do
        if [ -x "$cand" ]; then
            ASM_BIN="$cand"
            break
        fi
    done
fi
if [ -z "${ASM_BIN:-}" ]; then
    ASM_BIN="$(command -v asm-terminal 2>/dev/null || true)"
fi

if [ -z "${ASM_BIN:-}" ] || [ ! -x "$ASM_BIN" ]; then
    echo "asm-terminal-launch: could not locate the ASM Terminal binary." >&2
    echo "Install it (make install-desktop) or set ASM_BIN to the full path." >&2
    exit 1
fi

TITLE="ASM Terminal"
CLASS="asm-terminal"

# Try terminal emulators in order of ubiquity, using each one's CLI idiom.
# A missing emulator returns 0 so `set -e` does not stop the probe.
try() {
    prog="$1"
    shift
    command -v "$prog" >/dev/null 2>&1 || return 0
    exec "$prog" "$@"
}

# An explicit choice wins.
if [ -n "${ASM_TERMINAL_EMULATOR:-}" ]; then
    try "$ASM_TERMINAL_EMULATOR" -e "$ASM_BIN"
fi

# Prefer the desktop's own terminal.
case "${XDG_CURRENT_DESKTOP:-}" in
    *COSMIC*) try cosmic-term -e "$ASM_BIN" ;;
    *GNOME*)  try ptyxis --new-window -x "$ASM_BIN"
              try gnome-terminal --title="$TITLE" -- "$ASM_BIN" ;;
    *KDE*)    try konsole --title "$TITLE" -e "$ASM_BIN" ;;
    *XFCE*)   try xfce4-terminal --title="$TITLE" --command="$ASM_BIN" ;;
esac

# xdg-terminal-exec is the freedesktop default-terminal launcher.
try xdg-terminal-exec "$ASM_BIN"
# x-terminal-emulator is the Debian alternatives symlink.
try x-terminal-emulator -T "$TITLE" -e "$ASM_BIN"
try cosmic-term -e "$ASM_BIN"
try ptyxis --new-window -x "$ASM_BIN"
try gnome-terminal --title="$TITLE" -- "$ASM_BIN"
try konsole --title "$TITLE" -e "$ASM_BIN"
try xfce4-terminal --title="$TITLE" --command="$ASM_BIN"
try tilix --title="$TITLE" -e "$ASM_BIN"
try mate-terminal --title="$TITLE" -e "$ASM_BIN"
try lxterminal --title "$TITLE" -e "$ASM_BIN"
try terminator -T "$TITLE" -e "$ASM_BIN"
try alacritty --title "$TITLE" --class "$CLASS" -e "$ASM_BIN"
try kitty --title "$TITLE" --class "$CLASS" "$ASM_BIN"
try wezterm start --class "$CLASS" -- "$ASM_BIN"
try ghostty -e "$ASM_BIN"
try foot --title="$TITLE" "$ASM_BIN"
try st -T "$TITLE" -e "$ASM_BIN"
try urxvt -title "$TITLE" -e "$ASM_BIN"
try xterm -T "$TITLE" -e "$ASM_BIN"

echo "asm-terminal-launch: no supported terminal emulator found on PATH." >&2
echo "Install one of: cosmic-term, ptyxis, gnome-terminal, konsole, xterm, alacritty, kitty, foot, wezterm." >&2
exit 2
